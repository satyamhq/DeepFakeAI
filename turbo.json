{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@truemedia/detect#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_JWKS_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "RENDER_EXTERNAL_URL",
        "POSTMARK_TOKEN",
        "AION_API_KEY",
        "REALITY_API_KEY",
        "SENSITY_API_TOKEN",
        "SUPABASE_STORAGE_BUCKET",
        "GITHUB_REPO_CLONE_TOKEN",
        "GEMINI_API_KEY",
        "HIVE_ACCESS_KEY_ID",
        "HIVE_SECRET_KEY",
        "HIVE_API_KEY",
        "DFTOTAL_API_KEY",
        "GOOGLE_API_KEY",
        "VETRIC_API_KEY",
        "MICROSOFT_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "LOCCUS_API_KEY",
        "SLACK_TOKEN",
        "TWITTER_CONSUMER_KEY",
        "TWITTER_CONSUMER_SECRET",
        "TWITTER_ACCESS_TOKEN_KEY",
        "TWITTER_ACCESS_TOKEN_SECRET",
        "ANON_QUERY",
        "GROUND_TRUTH_UPDATE_EMAILS_ENABLED",
        "SCHEDULER_SHARED_AUTH_SECRET",
        "SCHEDULER_URL",
        "VERIFIED_LABEL_ENABLED"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^lint"]
    },
    "lint:fix": {},
    "check-types": {},
    "test": {}
  }
}
