# ==============================================================================
# DeepFakeAI Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# NEVER commit real credentials, API tokens, or secrets to version control.
#
# Production Deployment (Render / Vercel):
# - Set all REQUIRED variables in your hosting provider's Environment settings.
# - Set any OPTIONAL AI provider keys you wish to activate. The system includes
#   automatic fallback and will continue running smoothly if some keys are omitted.
# ==============================================================================

# ==============================================================================
# 1. CORE DATABASE & STORAGE (SUPABASE) — REQUIRED
# ==============================================================================
# Obtain from: Supabase Dashboard → Project Settings → API
#
# [PUBLIC] Supabase project REST URL (exposed to client browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [PUBLIC] Supabase Anon / Publishable Key (client-safe for public queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# [SERVER-ONLY] Supabase URL for backend server operations
SUPABASE_URL=https://your-project-ref.supabase.co

# [SERVER-ONLY] Supabase Service Role Secret Key (NEVER expose to client)
# Used for backend administrative operations and bypassing RLS for server actions
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# [OPTIONAL] Supabase storage bucket name for media uploads (defaults to media-uploads)
SUPABASE_STORAGE_BUCKET=media-uploads

# ==============================================================================
# 2. APPLICATION ACCESS & SITE URL — REQUIRED / RECOMMENDED
# ==============================================================================
# Set to true to allow anonymous users to upload and analyze media without forced login
ANON_QUERY=true

# Public canonical URL of the web service (no trailing slash)
# In local dev: http://localhost:3000
# On Render: https://your-service.onrender.com
NEXT_PUBLIC_SITE_URL_BASE=http://localhost:3000

# ==============================================================================
# 3. BACKGROUND SCHEDULER & MICROSERVICES — OPTIONAL (LOCAL / CLOUD)
# ==============================================================================
# Scheduler background worker service URL
SCHEDULER_URL=http://localhost:3005

# Shared cryptographic secret between web app and scheduler service
# Generate with: openssl rand -hex 32
SCHEDULER_SHARED_AUTH_SECRET=dev-shared-secret-change-me-in-production

# Next.js tRPC callback endpoint used by the scheduler
WEBAPP_TRPC_URL=http://localhost:3000/api/trpc

# Media resolver service URL for resolving remote social media posts
MEDIA_RESOLVER_URL=http://localhost:4000

# ==============================================================================
# 4. AI & DEEPFAKE DETECTION PROVIDERS — OPTIONAL
# ==============================================================================
# DeepFakeAI includes an automatic multi-provider fallback engine:
# Provider A → Provider B → Provider C → Provider D
# If an API key is missing or an external service fails, the engine
# automatically cascades to available providers. If all fail, a graceful
# status is returned without fabricating results.

# Reality Defender API (https://realitydefender.com)
REALITY_API_KEY=your-reality-defender-api-key

# AI or Not / AION API (https://aiornot.com)
AIORNOT_API_KEY=your-aiornot-api-key
AION_API_KEY=your-aion-api-key

# Hive Moderation API (https://thehive.ai)
# A single Hive key supports Image, Video, Audio, and Multimodal detection
HIVE_API_KEY=your-hive-api-key
HIVE_SECRET_KEY=your-hive-secret-key
HIVE_ACCESS_KEY_ID=your-hive-access-key-id

# Google Gemini API — used for LLM rationales & transcript analysis
GEMINI_API_KEY=your-gemini-api-key

# Sensity AI API (https://sensity.ai)
SENSITY_API_TOKEN=your-sensity-api-token

# Deepfake Total API (https://deepfake-total.com)
DFTOTAL_API_KEY=your-dftotal-api-key

# Loccus / Hiya AI Voice & Audio Detection
LOCCUS_API_KEY=your-loccus-api-key

# Google API Key — used for YouTube & verified source lookups
GOOGLE_API_KEY=your-google-api-key

# Vetric API Key — verified source metrics
VETRIC_API_KEY=your-vetric-api-key

# Microsoft Cognitive Services API Key
MICROSOFT_API_KEY=your-microsoft-api-key

# ==============================================================================
# 5. OBSERVABILITY & MONITORING — OPTIONAL
# ==============================================================================
# Sentry Error Monitoring & Release Tracking
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
ENABLE_SENTRY_BUILD_UPLOAD=false

# Google Analytics Measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# Internal Slack Webhook / Bot Token for Alerts
SLACK_TOKEN=xoxb-your-slack-bot-token

# Postmark Server Token for System Emails
POSTMARK_TOKEN=your-postmark-server-token

# ==============================================================================
# 6. FEATURE FLAGS — OPTIONAL
# ==============================================================================
GROUND_TRUTH_UPDATE_EMAILS_ENABLED=false
VERIFIED_LABEL_ENABLED=false
CREATE_PIPEDRIVE_CONTACT=false

# ==============================================================================
# 7. SOCIAL / BOT INTEGRATION — OPTIONAL (X / Twitter)
# ==============================================================================
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret
TWITTER_ACCESS_TOKEN_KEY=your-twitter-access-token-key
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret
