# ==============================================================================
# .env.example — Copy this to .env.local and fill in your values.
# NEVER commit real secrets. This file contains only dummy/example values.
# ==============================================================================

# ==============================================================================
# REQUIRED — App will not start without these
# ==============================================================================

# --- Database (Supabase PostgreSQL + Prisma) ---
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Project ref: acqqbhrwmxstfyatvrkw
#
# POSTGRES_PRISMA_URL  : Transaction pooler (port 6543). Used by Next.js + Scheduler at runtime.
# POSTGRES_URL_NON_POOLING : Direct connection (port 5432). Used by Prisma for migrations.
# POSTGRES_SHADOW_URL  : Direct connection (port 5432). Used by `prisma migrate dev` for shadow DB.
POSTGRES_PRISMA_URL=postgresql://postgres.acqqbhrwmxstfyatvrkw:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
POSTGRES_URL_NON_POOLING=postgresql://postgres.acqqbhrwmxstfyatvrkw:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
POSTGRES_SHADOW_URL=postgresql://postgres.acqqbhrwmxstfyatvrkw:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Authentication (Clerk) ---
# Get from: https://dashboard.clerk.com → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# --- Scheduler service ---
# The URL of the running scheduler service (local or remote).
SCHEDULER_URL=http://localhost:3005
# A shared secret used to authenticate requests between Next.js and the Scheduler.
# Generate with: openssl rand -hex 32
SCHEDULER_SHARED_AUTH_SECRET=dev-shared-secret-change-me-in-production

# --- Media Resolver service ---
# URL of the media-resolver service (https://github.com/DeepFakeAIorg/media-resolver)
MEDIA_RESOLVER_URL=http://localhost:4000

# ==============================================================================
# OPTIONAL — App starts without these; specific features will be degraded
# ==============================================================================

# --- Public site URL (used for Open Graph metadata and callback URLs) ---
# Leave unset in local dev — defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL_BASE=https://your-domain.com

# --- Clerk webhook secret (required for org-created webhook, optional otherwise) ---
CLERK_ORG_CREATED_WEBHOOK_SECRET=whsec_your_clerk_org_webhook_secret

# --- Scheduler callback URL (used when testing against production scheduler locally) ---
# Typically set to an ngrok URL pointing at your local Next.js instance.
SCHEDULER_TRPC_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/trpc

# --- Scheduler (used by the scheduler service itself to call back into Next.js) ---
WEBAPP_TRPC_URL=http://localhost:3000/api/trpc

# --- Email (Postmark) ---
POSTMARK_TOKEN=your-postmark-server-token

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# --- Analytics ---
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# --- Monitoring (Sentry) ---
# All three are required for Sentry source-map/release upload during build.
# If any are missing, the Sentry build plugin is skipped (runtime monitoring still works via DSN).
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# --- Feature flags ---
# Set to "true" to enable anonymous (unauthenticated) queries
ANON_QUERY=false
# Set to "true" to send emails when ground truth is updated
GROUND_TRUTH_UPDATE_EMAILS_ENABLED=false
# Set to "true" to show "Verified" labels in the UI
VERIFIED_LABEL_ENABLED=false
# Set to "true" to create Pipedrive contacts during onboarding (avoid in dev)
CREATE_PIPEDRIVE_CONTACT=false

# ==============================================================================
# API-SPECIFIC — Required only if you enable the corresponding detector
# ==============================================================================

# --- Reality Defender (realitydefender.com) ---
# Get from: https://app.realitydefender.com → API Keys
REALITY_API_KEY=your-reality-defender-api-key

# --- AIORNOT (aiornot.com) ---
# Get from: https://www.aiornot.com → Account → API
AIORNOT_API_KEY=your-aiornot-api-key

# --- Hive Moderation (thehive.ai) — image / video / audio detection ---
# Each model requires its own bearer token from: https://docs.thehive.ai/
# NOTE: These are Hive API bearer tokens, NOT AWS IAM credentials.
HIVE_VIDEO_API_KEY=your-hive-video-bearer-token
HIVE_IMAGE_API_KEY=your-hive-image-bearer-token
HIVE_IMGVID_MULTI_API_KEY=your-hive-imgvid-multi-bearer-token
HIVE_AUDIO_API_KEY=your-hive-audio-bearer-token

# --- Sensity AI ---
SENSITY_API_TOKEN=your-sensity-api-token

# --- AION (formerly Alt Freezing) ---
AION_API_KEY=your-aion-api-key

# --- DF Total (deepfake-total.com) ---
DFTOTAL_API_KEY=your-dftotal-api-key

# --- Loccus / Hiya AI (audio detection) ---
LOCCUS_API_KEY=your-loccus-api-key

# --- OpenAI (used for GPT-based analysis) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Google (YouTube / verified source lookup) ---
GOOGLE_API_KEY=your-google-api-key

# --- Vetric (verified source metrics) ---
VETRIC_API_KEY=your-vetric-api-key

# --- Microsoft ---
MICROSOFT_API_KEY=your-microsoft-api-key

# ==============================================================================
# SOCIAL / BOT — Required only if running the X (Twitter) bot
# ==============================================================================
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret
TWITTER_ACCESS_TOKEN_KEY=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Slack token for internal alerts
SLACK_TOKEN=xoxb-your-slack-bot-token

# ==============================================================================
# LOCAL DEV ONLY
# ==============================================================================

# Set to your ngrok URL when using Hive webhooks locally.
# Example: https://abc123.ngrok.io
LOCALHOST_NGROK_URL=

# ==============================================================================
# INTEGRATION TESTS
# ==============================================================================
# Set to "true" to run database integration tests. Requires a separate test DB:
#   createdb -O mylocaluser DeepFakeAI-integration-test
#   npm run db:integration-test
INTEGRATION=false

# ==============================================================================
# RENDER PRODUCTION DEPLOYMENT
# ==============================================================================
# Render service settings:
#   Build Command : npm install && npm run build:render
#   Start Command : npm run start (or npm run start:render)
#   Node Version  : 20 (auto-detected from .nvmrc)
#
# Add ALL variables from the REQUIRED section above to Render's Environment tab.
# Additionally set these production-specific overrides:
#
# Public URL of your Render web service (no trailing slash):
NEXT_PUBLIC_SITE_URL_BASE=https://your-service.onrender.com
#
# Scheduler URL (Render internal service URL or external):
SCHEDULER_URL=https://your-scheduler.onrender.com
WEBAPP_TRPC_URL=https://your-service.onrender.com/api/trpc
#
# Media resolver (separate service):
MEDIA_RESOLVER_URL=https://your-media-resolver.onrender.com
#
# Node memory — set automatically by build:render script; listed here for reference.
# NODE_OPTIONS=--max-old-space-size=2048
